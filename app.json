{
  "expo": {
    "name": "Securia",
    "slug": "Securia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "womensafetyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.securia.womensafety",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow WomenSafetyApp to recognize your spoken starting location.",
        "NSMicrophoneUsageDescription": "Allow WomenSafetyApp to use the microphone for voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "package": "com.securia.womensafety",
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lumi needs your location to find nearby places and recommend safer routes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow WomenSafetyApp to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow WomenSafetyApp to recognize your spoken starting location."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "11a2de9b-115c-48bf-8e4b-5b79d7fceb0f"
      }
    }
  }
}
